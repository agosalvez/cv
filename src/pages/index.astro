---
/**
 * Portada: quién soy, qué ofrezco y cómo contactar, en una pantalla.
 *
 * Antes `/` redirigía al CV. El CV habla a quien contrata a un empleado; la
 * portada habla a quien busca un servicio, y deja el CV a un clic.
 *
 * El contacto principal es WhatsApp: quien llega aquí suele venir de un
 * referido o de LinkedIn, y escribe antes que rellenar un formulario.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import { homeFacts, homeFooter, homeHero, homeSeo, homeServices, whatsappLink } from '../data/home';
import { trainingImages } from '../data/training';

const { personal } = JSON.parse(readFileSync(join(process.cwd(), 'src/data/cv.json'), 'utf8'));

const portrait = trainingImages.portrait;
const mainWhatsapp = whatsappLink(homeHero.whatsappMessage);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: homeSeo.title,
  description: homeSeo.description,
  url: 'https://gosalvez.es/',
  inLanguage: 'es-ES',
  mainEntity: {
    '@type': 'Person',
    name: personal.name,
    jobTitle: personal.title,
    url: 'https://gosalvez.es',
    image: `https://gosalvez.es${portrait.src}`,
    sameAs: [personal.linkedin, personal.github],
  },
};

const container = 'mx-auto max-w-screen-xl px-6 lg:px-10';
const focusDark = 'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400';
const focusLight = 'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600';
---

<Layout
  title={homeSeo.title}
  lang="es"
  description={homeSeo.description}
  canonical="https://gosalvez.es/"
  alternateUrls={null}
  ogImage={`https://gosalvez.es${portrait.src}`}
  ogType="website"
  jsonLd={jsonLd}
>
  <main>
    <!-- ══════════ PRESENTACIÓN ══════════ -->
    <header class="bg-slate-900 pb-14 pt-12 lg:pb-20 lg:pt-20">
      <div class={container}>
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-14">
          <div class="lg:col-span-7">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-blue-400">{homeHero.eyebrow}</p>
            <h1 class="mt-5 max-w-2xl text-3xl font-bold leading-[1.15] tracking-tight text-white sm:text-4xl lg:text-[2.75rem]">
              {homeHero.title}
            </h1>
            <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-300">
              <span class="font-semibold text-white">{personal.name}.</span>
              {' '}{homeHero.intro}
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
              {
                mainWhatsapp && (
                  <a
                    href={mainWhatsapp}
                    target="_blank"
                    rel="noopener"
                    data-umami-event="home-whatsapp"
                    class={`inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-500 ${focusDark}`}
                  >
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.99 2.896 9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.9 11.9 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.82 11.82 0 0 0 20.464 3.488" />
                    </svg>
                    {homeHero.whatsappLabel}
                  </a>
                )
              }
              <a
                href="/es"
                data-umami-event="home-cv"
                class={`inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-slate-700 px-5 py-3 text-sm font-semibold text-slate-200 transition-colors hover:border-slate-600 hover:bg-slate-800 ${focusDark}`}
              >
                {homeHero.cvLabel}
              </a>
              <a
                href={personal.linkedin}
                target="_blank"
                rel="noopener"
                data-umami-event="home-linkedin"
                class={`inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg px-3 py-3 text-sm font-semibold text-slate-400 transition-colors hover:text-white ${focusDark}`}
              >
                {homeHero.linkedinLabel}
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H8M17 7v9" />
                </svg>
              </a>
            </div>

            <dl class="mt-10 grid max-w-2xl grid-cols-1 gap-5 border-t border-slate-800 pt-7 sm:grid-cols-3">
              {
                homeFacts.map((fact) => (
                  <div>
                    <dt class="font-mono text-lg font-semibold tracking-tight text-white">{fact.value}</dt>
                    <dd class="mt-1 text-xs leading-snug text-slate-400">{fact.label}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <!-- En móvil la foto va después de los botones: la primera pantalla lleva al contacto. -->
          <div class="lg:col-span-5">
            <img
              src={portrait.src}
              alt={portrait.alt.es}
              width={portrait.width}
              height={portrait.height}
              class="mx-auto w-full max-w-xs rounded-2xl object-cover ring-1 ring-slate-700 lg:max-w-sm"
            />
          </div>
        </div>
      </div>
    </header>

    <!-- ══════════ QUÉ OFREZCO ══════════ -->
    <section aria-labelledby="servicios-title" class="bg-white py-14 lg:py-20">
      <div class={container}>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-blue-600">Cómo puedo ayudarte</p>
        <h2 id="servicios-title" class="mt-3 max-w-3xl text-2xl font-bold tracking-tight text-slate-900 sm:text-[1.75rem]">
          Dos formas de trabajar juntos
        </h2>

        <ul class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
          {
            homeServices.map((service) => {
              const href = service.href ?? whatsappLink(service.whatsappMessage);
              const external = service.href === null;
              return (
                <li class="grid gap-3 py-7 lg:grid-cols-12 lg:items-baseline lg:gap-14">
                  <h3 class="text-lg font-semibold tracking-tight text-slate-900 lg:col-span-4">{service.title}</h3>
                  <div class="lg:col-span-5">
                    <p class="text-[15px] leading-relaxed text-slate-600">{service.text}</p>
                    {service.price && <p class="mt-2 font-mono text-sm text-slate-500">{service.price}</p>}
                  </div>
                  {href && (
                    <div class="lg:col-span-3 lg:text-right">
                      <a
                        href={href}
                        target={external ? '_blank' : undefined}
                        rel={external ? 'noopener' : undefined}
                        data-umami-event={`home-${service.id}`}
                        class={`inline-flex items-center gap-2 text-sm font-semibold text-blue-700 transition-colors hover:text-blue-800 ${focusLight}`}
                      >
                        {service.cta}
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                      </a>
                    </div>
                  )}
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-200 bg-slate-50 py-8">
    <div class={`${container} flex flex-col gap-3 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between`}>
      <p>{personal.name} · {personal.locationEs}</p>
      <a
        href="/en"
        hreflang="en"
        lang="en"
        class={`font-medium text-slate-600 transition-colors hover:text-slate-900 ${focusLight}`}
      >
        {homeFooter.englishLabel}
      </a>
    </div>
  </footer>
</Layout>
