---
/**
 * Barra de navegación de `/setup`.
 *
 * La barra es común a las páginas internas y vive en `SiteNav`; aquí solo se
 * fija cuál es la página actual y cuál es su equivalente en el otro idioma.
 */
import SiteNav from '../site/SiteNav.astro';
import { type SetupLang } from '../../data/setup';

interface Props {
  lang: SetupLang;
  name: string;
}

const { lang, name } = Astro.props;
const otherLang: SetupLang = lang === 'es' ? 'en' : 'es';
---

<SiteNav lang={lang} name={name} current="setup" altHref={`/${otherLang}/setup`} />
