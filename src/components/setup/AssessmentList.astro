---
import { localize, type Localized, type SetupLang } from '../../data/setup';

interface Props {
  items: Localized[];
  lang: SetupLang;
  /** El listado de mejoras se numera; el de aciertos, no. */
  numbered?: boolean;
}

const { items, lang, numbered = false } = Astro.props;
---

{
  numbered ? (
    <ol class="divide-y divide-slate-200 border-t border-slate-200">
      {items.map((item, index) => (
        <li class="flex gap-4 py-4">
          <span class="mt-0.5 font-mono text-xs text-blue-600">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span class="text-[15px] leading-relaxed text-slate-700">{localize(item, lang)}</span>
        </li>
      ))}
    </ol>
  ) : (
    <ul class="grid gap-x-10 gap-y-4 border-t border-slate-200 pt-6 sm:grid-cols-2">
      {items.map((item) => (
        <li class="flex gap-3 text-[15px] leading-relaxed text-slate-700">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500" aria-hidden="true" />
          <span>{localize(item, lang)}</span>
        </li>
      ))}
    </ul>
  )
}
