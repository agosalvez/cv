---
import { displayDiagram, localize, type SetupLang } from '../../data/setup';

interface Props {
  lang: SetupLang;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
---

<figure class:list={['rounded-lg border border-slate-200 bg-slate-50 p-6 sm:p-8', className]}>
  <!-- La proporción del contenedor reproduce la del conjunto de las tres pantallas. -->
  <div class="flex aspect-[16/5] items-end justify-center gap-3 sm:gap-4" aria-hidden="true">
    {
      displayDiagram.panels.map((panel) => (
        <div class="flex h-full flex-col justify-end" style={`width:${panel.widthPercent}%`}>
          <div
            class="w-full rounded-sm border border-slate-300 bg-white shadow-sm"
            style={`height:${panel.heightPercent}%`}
          />
          <div class="mx-auto mt-1 h-1.5 w-1/3 rounded-b bg-slate-300" />
        </div>
      ))
    }
  </div>

  <ul class="mt-5 grid grid-cols-3 gap-3 border-t border-slate-200 pt-4" aria-hidden="true">
    {
      displayDiagram.panels.map((panel) => (
        <li class="text-center">
          <p class="font-mono text-[10px] uppercase tracking-wider text-slate-500">
            {localize(panel.label, lang)}
          </p>
          <p class="mt-0.5 text-xs text-slate-600">{localize(panel.caption, lang)}</p>
        </li>
      ))
    }
  </ul>

  <figcaption class="mt-5 text-sm leading-relaxed text-slate-500">
    {localize(displayDiagram.caption, lang)}
  </figcaption>
</figure>
