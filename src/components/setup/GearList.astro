---
import { localize, localizeName, setupUi, type GearGroup, type SetupLang } from '../../data/setup';

interface Props {
  groups: GearGroup[];
  lang: SetupLang;
}

const { groups, lang } = Astro.props;
---

<div class="space-y-10">
  {
    groups.map((group) => {
      const EntryHeading = group.label ? 'h4' : 'h3';

      return (
        <div>
          {group.label && (
            <h3 class="mb-5 font-mono text-xs uppercase tracking-[0.2em] text-slate-500">
              {localize(group.label, lang)}
            </h3>
          )}

          <ul class="divide-y divide-slate-200 border-t border-slate-200">
            {group.entries.map((entry) => (
              <li class="py-6">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <EntryHeading class="text-base font-semibold tracking-tight text-slate-900">
                    {localizeName(entry.name, lang)}
                  </EntryHeading>
                  {entry.link && (
                    <a
                      href={entry.link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      /* El texto visible se repite en cada entrada: el nombre del producto
                         evita enlaces indistinguibles fuera de contexto. */
                      aria-label={`${localize(entry.link.label, lang)}: ${localizeName(entry.name, lang)} (${localize(setupUi.newTab, lang)})`}
                      class="inline-flex shrink-0 items-center gap-1 text-xs font-medium text-slate-500 underline-offset-4 transition-colors hover:text-blue-600 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
                    >
                      {localize(entry.link.label, lang)}
                      <svg
                        class="h-3 w-3"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    </a>
                  )}
                </div>

                <p class="mt-1.5 font-mono text-[11px] uppercase tracking-wider text-slate-500">
                  {localize(entry.role, lang)}
                </p>

                <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-slate-600">
                  {localize(entry.notes, lang)}
                </p>

                {entry.specs && (
                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {entry.specs.map((spec) => (
                      <li class="rounded border border-slate-200 bg-slate-50 px-2 py-0.5 font-mono text-xs text-slate-600">
                        {localize(spec, lang)}
                      </li>
                    ))}
                  </ul>
                )}

                {entry.pending && (
                  <p class="mt-4 text-sm text-slate-600">
                    <span class="font-mono text-[11px] uppercase tracking-wider text-slate-500">
                      {localize(setupUi.pending, lang)} ·{' '}
                    </span>
                    {localize(entry.pending, lang)}
                  </p>
                )}

                {entry.change && (
                  <p class="mt-4 max-w-2xl border-l-2 border-blue-200 pl-4 text-sm leading-relaxed text-slate-600">
                    <span class="font-semibold text-slate-800">
                      {localize(setupUi.change, lang)}:{' '}
                    </span>
                    {localize(entry.change, lang)}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      );
    })
  }
</div>
