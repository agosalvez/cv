---
import SetupFigure from './SetupFigure.astro';
import { localize, setupHero, type SetupLang } from '../../data/setup';

interface Props {
  lang: SetupLang;
}

const { lang } = Astro.props;
---

<header class="bg-slate-900 pb-16 pt-28 lg:pb-24 lg:pt-32">
  <div class="mx-auto max-w-screen-xl px-6 lg:px-10">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-6">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-blue-400">
          {localize(setupHero.eyebrow, lang)}
        </p>
        <h1 class="mt-5 text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl lg:text-[2.75rem]">
          {localize(setupHero.title, lang)}
        </h1>
        <p class="mt-6 max-w-xl text-[15px] leading-relaxed text-slate-300 sm:text-base">
          {localize(setupHero.intro, lang)}
        </p>
        <ul class="mt-8 flex flex-wrap gap-2">
          {
            setupHero.uses.map((use) => (
              <li class="rounded-full border border-slate-700 px-3 py-1 font-mono text-xs text-slate-300">
                {localize(use, lang)}
              </li>
            ))
          }
        </ul>
      </div>

      <SetupFigure
        image={setupHero.image}
        lang={lang}
        aspect="aspect-[3/2]"
        priority
        class="lg:col-span-6"
      />
    </div>
  </div>
</header>
