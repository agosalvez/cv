---
/**
 * Botones de contacto.
 *
 * La página se abre casi siempre después de haber hablado conmigo —referido o
 * tarjeta con QR—, y en ese contexto casi nadie rellena un formulario: escribe
 * por WhatsApp. El formulario queda como segunda opción, para quien prefiere
 * dejar los detalles por escrito.
 *
 * Mientras `trainingContact.whatsapp` sea `null`, el botón no se renderiza y
 * el formulario ocupa su lugar como acción principal.
 */
import { localize, trainingContact, type TrainingLang } from '../../data/training';

interface Props {
  lang: TrainingLang;
  /** `dark` sobre el fondo oscuro de la cabecera; `light` sobre fondo claro. */
  tone?: 'dark' | 'light';
  /** Se oculta junto al propio formulario: ahi el enlace no llevaria a ninguna parte. */
  showForm?: boolean;
  class?: string;
}

const { lang, tone = 'dark', showForm = true, class: className = '' } = Astro.props;

const whatsappUrl = trainingContact.whatsapp
  ? `https://wa.me/${trainingContact.whatsapp}?text=${encodeURIComponent(
      localize(trainingContact.whatsappMessage, lang),
    )}`
  : null;

const primary =
  'inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400';

const secondary =
  tone === 'dark'
    ? 'inline-flex items-center justify-center gap-2 rounded-lg border border-slate-700 px-5 py-3 text-sm font-semibold text-slate-200 transition-colors hover:border-slate-600 hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400'
    : 'inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600';
---

<div class:list={['flex flex-col gap-3 sm:flex-row sm:items-center', className]}>
  {
    whatsappUrl && (
      <a href={whatsappUrl} target="_blank" rel="noopener" class={primary}>
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.99 2.896 9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.9 11.9 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.82 11.82 0 0 0 20.464 3.488" />
        </svg>
        {localize(trainingContact.whatsappLabel, lang)}
      </a>
    )
  }

  {(showForm || !whatsappUrl) && (
  <a href="#solicitar" class={whatsappUrl ? secondary : primary}>
    {whatsappUrl ? localize(trainingContact.formLabel, lang) : localize(trainingContact.requestLabel, lang)}
    {
      !whatsappUrl && (
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      )
    }
  </a>
  )}
</div>
