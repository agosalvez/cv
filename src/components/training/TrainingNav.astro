---
/**
 * Barra de navegación de la landing de formación.
 *
 * A diferencia del resto del sitio, aquí no se navega entre CV, formación y
 * setup: quien llega ha escaneado un QR o ha seguido un enlace tras hablar
 * conmigo, y viene a por un servicio. Enlaces a «Trayectoria» y «Setup» en esa
 * posición dicen «web personal» justo donde hace falta decir «proveedor», y el
 * de setup además es una vía de fuga hacia contenido que a un cliente no le
 * interesa. El enlace al CV se mantiene, pero dentro de «Quién la imparte»,
 * que es donde surge la pregunta.
 *
 * Por eso la barra navega la propia página y deja el contacto siempre visible.
 * Tampoco lleva conmutador de idioma: el servicio se vende a pymes españolas y
 * un selector ES/EN en la barra invita a irse de la página que se acaba de
 * abrir. La versión inglesa sigue existiendo y accesible por su URL.
 *
 * Bajo `lg` las secciones se pliegan en un desplegable. Antes iban en una tira
 * horizontal, pero una tira desplazable no anuncia que haya más contenido a la
 * derecha: se veían tres secciones y las otras cuatro no existían para el
 * visitante. El botón, además, devuelve una fila entera de alto en una página
 * que se lee sobre todo desde el móvil.
 */
import { localize, trainingContact, type Localized, type TrainingLang } from '../../data/training';

interface Props {
  lang: TrainingLang;
  name: string;
  items: { id: string; label: Localized }[];
}

const { lang, name, items } = Astro.props;

const t = {
  es: { nav: 'Navegación', contact: 'Contacto', menu: 'Secciones', close: 'Cerrar' },
  en: { nav: 'Navigation', contact: 'Contact', menu: 'Sections', close: 'Close' },
}[lang];

const whatsappUrl = trainingContact.whatsapp
  ? `https://wa.me/${trainingContact.whatsapp}?text=${encodeURIComponent(
      localize(trainingContact.whatsappMessage, lang),
    )}`
  : null;

/** Iniciales para móvil: el nombre completo empuja el resto fuera de pantalla. */
const initials = name
  .split(/\s+/)
  .map((word) => word[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

const linkClass =
  'toc-link whitespace-nowrap rounded-md font-medium text-slate-400 transition-colors hover:bg-slate-800 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400';
---

<nav class="sticky top-0 z-50 border-b border-slate-800 bg-slate-900/95 backdrop-blur" aria-label={t.nav}>
  <div class="mx-auto flex h-16 max-w-screen-xl items-center justify-between gap-3 px-6 lg:px-10">
    <a
      href="#contenido"
      class="shrink-0 text-sm font-bold tracking-tight text-white transition-colors hover:text-blue-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
      aria-label={name}
    >
      <span class="sm:hidden" aria-hidden="true">{initials}</span>
      <span class="hidden sm:inline">{name}</span>
    </a>

    <!-- En pantalla ancha caben todas las secciones a la vista. -->
    <ul class="hidden items-center gap-1 text-sm lg:flex">
      {
        items.map((item) => (
          <li>
            <a href={`#${item.id}`} data-toc={item.id} class={`${linkClass} px-3 py-1.5`}>
              {localize(item.label, lang)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      {
        whatsappUrl ? (
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400 sm:px-3.5 sm:text-sm"
          >
            <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.99 2.896 9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.9 11.9 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.82 11.82 0 0 0 20.464 3.488" />
            </svg>
            <span class="hidden sm:inline">WhatsApp</span>
          </a>
        ) : (
          <a
            href="#solicitar"
            class="rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400 sm:text-sm"
          >
            {t.contact}
          </a>
        )
      }

      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label={t.menu}
        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-700 px-2.5 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-slate-600 hover:bg-slate-800 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400 lg:hidden"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            id="nav-icon"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <span class="hidden xs:inline">{t.menu}</span>
      </button>
    </div>
  </div>

  <!-- Desplegable de secciones. Oculto de partida y sin JavaScript queda
       accesible, porque el enlace de salto lleva al contenido igualmente. -->
  <div id="nav-panel" hidden class="border-t border-slate-800 lg:hidden">
    <ul class="mx-auto max-w-screen-xl px-4 py-2">
      {
        items.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-toc={item.id}
              class={`${linkClass} block px-3 py-2.5 text-[15px]`}
            >
              {localize(item.label, lang)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  /* Un solo punto de corte propio: por debajo de 380 px el rótulo del botón
     compite con el de WhatsApp por el ancho. */
  @media (min-width: 380px) {
    .xs\:inline {
      display: inline;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  const icon = document.getElementById('nav-icon');

  const HAMBURGER = 'M4 6h16M4 12h16M4 18h16';
  const CROSS = 'M6 18L18 6M6 6l12 12';

  if (toggle && panel && icon) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      icon.setAttribute('d', open ? CROSS : HAMBURGER);
    };

    toggle.addEventListener('click', () => setOpen(panel.hidden));

    // Al elegir una sección el panel sobra: taparía justo lo que se va a leer.
    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Un toque fuera cierra: en móvil es el gesto que espera todo el mundo.
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (!panel.hidden && !panel.contains(target) && !toggle.contains(target)) setOpen(false);
    });

    // Al pasar a pantalla ancha los enlaces vuelven a la barra: el panel
    // quedaría abierto y vacío de sentido.
    matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Resalta la sección visible. Los enlaces están duplicados (barra ancha y
  // panel), así que se marcan todos los que apuntan a la misma sección.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));

  const setActive = (id: string | undefined) => {
    for (const link of links) {
      const active = link.dataset.toc === id;
      link.classList.toggle('bg-slate-800', active);
      link.classList.toggle('text-white', active);
      link.classList.toggle('text-slate-400', !active);
      if (active) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
  };

  const sections = [...new Set(links.map((link) => link.dataset.toc ?? ''))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (visible) setActive(visible.target.id);
    },
    { rootMargin: '-30% 0px -60% 0px', threshold: 0 },
  );

  sections.forEach((section) => observer.observe(section));
</script>
