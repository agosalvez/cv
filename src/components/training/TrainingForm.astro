---
/**
 * Formulario de solicitud.
 *
 * Publica en `/api/contacto`, servido por el mismo Express que sirve el sitio
 * (`admin/server.js`). El correo lo envía el servidor: la dirección de destino
 * vive en `CONTACT_TO` y no llega nunca al navegador.
 *
 * Sin JavaScript el formulario no envía; por eso el botón solo aparece
 * habilitado cuando el script ha tomado el control del `submit`.
 */
import { contactEndpoint, localize, trainingForm, type TrainingLang } from '../../data/training';

interface Props {
  lang: TrainingLang;
}

const { lang } = Astro.props;
const f = trainingForm;

const fieldClass =
  'mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/20 disabled:bg-slate-50 disabled:text-slate-500';
const labelClass = 'block text-xs font-semibold uppercase tracking-wide text-slate-500';
---

<div class="rounded-2xl bg-white p-7 shadow-xl shadow-slate-950/20 lg:p-8">
  <h3 class="text-lg font-bold tracking-tight text-slate-900">{localize(f.title, lang)}</h3>
  <p class="mt-2 text-sm leading-relaxed text-slate-600">{localize(f.intro, lang)}</p>

  <form
    id="training-form"
    class="mt-6 space-y-4"
    data-endpoint={contactEndpoint}
    data-sending={localize(f.status.sending, lang)}
    data-success={localize(f.status.success, lang)}
    data-error={localize(f.status.error, lang)}
    data-invalid={localize(f.status.invalid, lang)}
    data-rate-limit={localize(f.status.rateLimit, lang)}
    data-submit={localize(f.submit, lang)}
  >
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class={labelClass} for="tf-name">{localize(f.fields.name.label, lang)}</label>
        <input
          class={fieldClass}
          id="tf-name"
          name="name"
          type="text"
          required
          maxlength="120"
          autocomplete="name"
          placeholder={localize(f.fields.name.placeholder, lang)}
        />
      </div>

      <div>
        <label class={labelClass} for="tf-company">{localize(f.fields.company.label, lang)}</label>
        <input
          class={fieldClass}
          id="tf-company"
          name="company"
          type="text"
          required
          maxlength="120"
          autocomplete="organization"
          placeholder={localize(f.fields.company.placeholder, lang)}
        />
      </div>

      <div>
        <label class={labelClass} for="tf-email">{localize(f.fields.email.label, lang)}</label>
        <input
          class={fieldClass}
          id="tf-email"
          name="email"
          type="email"
          required
          maxlength="160"
          autocomplete="email"
          placeholder={localize(f.fields.email.placeholder, lang)}
        />
      </div>

      <div>
        <label class={labelClass} for="tf-attendees">
          {localize(f.fields.attendees.label, lang)}
          <span class="font-normal normal-case tracking-normal text-slate-400">
            ({localize(f.optional, lang)})
          </span>
        </label>
        <input
          class={fieldClass}
          id="tf-attendees"
          name="attendees"
          type="number"
          min="1"
          max="999"
          inputmode="numeric"
          placeholder={localize(f.fields.attendees.placeholder, lang)}
        />
      </div>
    </div>

    <div>
      <label class={labelClass} for="tf-format">{localize(f.fields.format.label, lang)}</label>
      <select class={fieldClass} id="tf-format" name="format" required>
        {
          f.formatOptions.map((option) => (
            <option value={localize(option.label, lang)} data-program={option.value}>
              {localize(option.label, lang)}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label class={labelClass} for="tf-message">{localize(f.fields.message.label, lang)}</label>
      <textarea
        class={fieldClass}
        id="tf-message"
        name="message"
        rows="4"
        required
        maxlength="4000"
        placeholder={localize(f.fields.message.placeholder, lang)}></textarea>
    </div>

    {/* Señuelo: invisible para las personas, irresistible para los bots. */}
    <div class="absolute left-[-9999px]" aria-hidden="true">
      <label for="tf-website">Website</label>
      <input id="tf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <button
      id="training-submit"
      type="submit"
      class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:cursor-not-allowed disabled:bg-slate-400"
    >
      {localize(f.submit, lang)}
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </button>

    <p
      id="training-status"
      role="status"
      aria-live="polite"
      class="hidden rounded-lg px-3.5 py-2.5 text-sm leading-relaxed"
    >
    </p>

    <p class="text-xs leading-relaxed text-slate-500">{localize(f.privacy, lang)}</p>
  </form>
</div>

<script>
  const form = document.getElementById('training-form') as HTMLFormElement | null;
  const status = document.getElementById('training-status');
  const button = document.getElementById('training-submit') as HTMLButtonElement | null;

  if (form && status && button) {
    const messages = {
      sending: form.dataset.sending ?? '',
      success: form.dataset.success ?? '',
      error: form.dataset.error ?? '',
      invalid: form.dataset.invalid ?? '',
      rateLimit: form.dataset.rateLimit ?? '',
    };

    const tones = {
      pending: ['bg-slate-100', 'text-slate-600'],
      ok: ['bg-emerald-50', 'text-emerald-800'],
      ko: ['bg-red-50', 'text-red-700'],
    };

    const show = (text: string, tone: keyof typeof tones) => {
      status.textContent = text;
      status.classList.remove('hidden', ...tones.pending, ...tones.ok, ...tones.ko);
      status.classList.add(...tones[tone]);
    };

    const setBusy = (busy: boolean) => {
      button.disabled = busy;
      for (const field of form.elements) {
        if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement) {
          field.disabled = busy;
        }
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      // El payload se compone antes de bloquear: un campo deshabilitado no
      // entra en el FormData, y el envío saldría vacío.
      const payload = JSON.stringify(Object.fromEntries(new FormData(form)));

      setBusy(true);
      show(messages.sending, 'pending');

      try {
        const response = await fetch(form.dataset.endpoint ?? '', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: payload,
        });

        if (response.ok) {
          form.reset();
          // Enviado: se retira el formulario para que nadie lo repita sin querer.
          for (const element of form.querySelectorAll(':scope > *')) {
            if (element !== status) element.classList.add('hidden');
          }
          show(messages.success, 'ok');
          return;
        }

        setBusy(false);
        if (response.status === 429) show(messages.rateLimit, 'ko');
        else if (response.status === 400) show(messages.invalid, 'ko');
        else show(messages.error, 'ko');
      } catch {
        setBusy(false);
        show(messages.error, 'ko');
      }
    });

    // Las tarjetas de modalidad dejan preseleccionada su opción al ir al formulario.
    const select = form.querySelector<HTMLSelectElement>('#tf-format');

    for (const trigger of document.querySelectorAll<HTMLAnchorElement>('a[data-program]')) {
      trigger.addEventListener('click', () => {
        const option = select?.querySelector<HTMLOptionElement>(
          `option[data-program="${trigger.dataset.program}"]`,
        );
        if (select && option) select.value = option.value;
      });
    }
  }
</script>
