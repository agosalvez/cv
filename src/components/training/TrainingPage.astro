---
/**
 * Composición de la landing de formación.
 *
 * Las dos rutas (`/es/formacion` y `/en/training`) son archivos de una línea
 * que renderizan este componente: el slug está traducido, pero la página es
 * exactamente la misma.
 *
 * El orden de las secciones responde al canal real de la página: casi nadie
 * llega por búsqueda. Se abre después de haber hablado conmigo —un referido,
 * una tarjeta con QR— o cuando alguien la reenvía dentro de la empresa. Por
 * eso lo primero no es convencer, sino dar el argumento en horas de trabajo y
 * el precio, que es lo que se discute cuando yo ya no estoy delante.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../../layouts/Layout.astro';
import TrainingNav from './TrainingNav.astro';
import ContactButtons from './ContactButtons.astro';
import FaqList from './FaqList.astro';
import ImpactTable from './ImpactTable.astro';
import ProgramCard from './ProgramCard.astro';
import TrainingForm from './TrainingForm.astro';
import UseCaseGrid from './UseCaseGrid.astro';
import {
  localize,
  trainingAbout,
  trainingClosing,
  trainingFaq,
  trainingHero,
  trainingImages,
  trainingImpact,
  trainingNotFor,
  trainingPricing,
  trainingPrograms,
  trainingProblem,
  trainingProcess,
  trainingRoutes,
  trainingSeo,
  trainingSessionDay,
  trainingUi,
  trainingUrls,
  trainingUseCases,
  type TrainingLang,
} from '../../data/training';

interface Props {
  lang: TrainingLang;
}

const { lang } = Astro.props;
const otherLang: TrainingLang = lang === 'es' ? 'en' : 'es';

const { personal } = JSON.parse(readFileSync(join(process.cwd(), 'src/data/cv.json'), 'utf8'));

const title = localize(trainingSeo.title, lang);
const description = localize(trainingSeo.description, lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: localize(trainingHero.title, lang),
  description,
  serviceType:
    lang === 'es'
      ? 'Formación en inteligencia artificial para empresas'
      : 'Artificial intelligence training for companies',
  url: trainingUrls[lang],
  areaServed: { '@type': 'Country', name: 'España' },
  audience: { '@type': 'BusinessAudience', name: lang === 'es' ? 'Pymes y empresas' : 'SMEs and companies' },
  provider: {
    '@type': 'Person',
    name: personal.name,
    jobTitle: personal.title,
    url: 'https://gosalvez.es',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: lang === 'es' ? 'Modalidades de formación' : 'Training formats',
    itemListElement: trainingPrograms.map((program) => ({
      '@type': 'Offer',
      ...(program.priceFrom !== null
        ? { price: program.priceFrom, priceCurrency: 'EUR', availability: 'https://schema.org/InStock' }
        : {}),
      itemOffered: {
        '@type': 'Course',
        name: localize(program.title, lang),
        description: localize(program.summary, lang),
        provider: { '@type': 'Person', name: personal.name },
      },
    })),
  },
  // Las preguntas frecuentes se declaran para que puedan mostrarse en buscadores.
  mainEntityOfPage: {
    '@type': 'FAQPage',
    mainEntity: trainingFaq.items.map((item) => ({
      '@type': 'Question',
      name: localize(item.question, lang),
      acceptedAnswer: { '@type': 'Answer', text: localize(item.answer, lang) },
    })),
  },
};

/** Secciones que aparecen en el índice. No están todas: solo las que se buscan. */
const tocItems = [
  { id: 'argumento', label: { es: 'El argumento', en: 'The case' } },
  { id: 'modalidades', label: { es: 'Modalidades y precio', en: 'Formats and price' } },
  { id: 'aplicaciones', label: { es: 'Aplicaciones', en: 'Applications' } },
  { id: 'proceso', label: { es: 'Cómo funciona', en: 'How it works' } },
  { id: 'preguntas', label: { es: 'Preguntas frecuentes', en: 'FAQ' } },
  { id: 'quien', label: { es: 'Quién la imparte', en: 'Who runs it' } },
  { id: 'solicitar', label: { es: 'Contacto', en: 'Contact' } },
];

/**
 * Una foto se publica solo cuando es real.
 *
 * Los marcadores llevan impresas las instrucciones de la sesión de fotos, y en
 * producción quedarían a la vista de cualquier visitante. Se muestran en
 * desarrollo, para trabajar con ellos, y desaparecen en la web publicada hasta
 * que la fotografía real sustituya al marcador (`temporary: false`).
 */
const showPhoto = (image: { temporary: boolean }) => import.meta.env.DEV || !image.temporary;

/** Importes con el separador de miles de cada idioma. */
const money = (amount: number) => amount.toLocaleString(lang === 'es' ? 'es-ES' : 'en-GB');

/** Estilos compartidos por los rótulos y encabezados de sección. */
const eyebrow = 'font-mono text-xs uppercase tracking-[0.2em] text-blue-600';
const heading = 'mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-[1.75rem]';
const container = 'mx-auto max-w-screen-xl px-6 lg:px-10';
const lead = 'mt-4 max-w-2xl text-[15px] leading-relaxed text-slate-600';
---

<Layout
  title={title}
  lang={lang}
  description={description}
  canonical={trainingUrls[lang]}
  alternateUrls={trainingUrls}
  ogType="website"
  jsonLd={jsonLd}
>
  <a
    href="#contenido"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-slate-900 focus:shadow-lg focus:outline focus:outline-2 focus:outline-blue-600"
  >
    {localize(trainingUi.skipToContent, lang)}
  </a>

  <TrainingNav lang={lang} name={personal.name} items={tocItems} />

  <main id="contenido">
    <!-- ══════════ CABECERA ══════════ -->
    <header class="bg-slate-900 pb-14 pt-10 lg:pb-20 lg:pt-16">
      <div class={container}>
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-14">
          <div class:list={[showPhoto(trainingImages.portrait) ? 'lg:col-span-7' : 'lg:col-span-9']}>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-blue-400">
              {localize(trainingHero.eyebrow, lang)}
            </p>
            <h1 class="mt-5 max-w-2xl text-3xl font-bold leading-[1.15] tracking-tight text-white sm:text-4xl lg:text-[2.75rem]">
              {localize(trainingHero.title, lang)}
            </h1>
            <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-300">
              {localize(trainingHero.intro, lang)}
            </p>

            <ContactButtons lang={lang} class="mt-8" />

            <dl class="mt-10 grid max-w-2xl grid-cols-1 gap-5 border-t border-slate-800 pt-7 sm:grid-cols-3">
              {
                trainingHero.facts.map((fact) => (
                  <div>
                    <dt class="font-mono text-lg font-semibold tracking-tight text-white sm:text-xl">
                      {localize(fact.value, lang)}
                    </dt>
                    <dd class="mt-1 text-xs leading-snug text-slate-400">{localize(fact.label, lang)}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <!-- En móvil la foto va después de los botones: la primera pantalla
               tiene que llevar al contacto, no a un retrato. -->
          {
            showPhoto(trainingImages.portrait) && (
              <div class="lg:col-span-5">
                <img
                  src={trainingImages.portrait.src}
                  alt={localize(trainingImages.portrait.alt, lang)}
                  width={trainingImages.portrait.width}
                  height={trainingImages.portrait.height}
                  class="mx-auto w-full max-w-xs rounded-2xl object-cover ring-1 ring-slate-700 lg:max-w-none"
                />
              </div>
            )
          }
        </div>
      </div>
    </header>

    <!-- ══════════ EL ARGUMENTO ══════════ -->
    <section id="argumento" aria-labelledby="argumento-title" class="scroll-mt-36 lg:scroll-mt-24 bg-white py-14 lg:py-20">
      <div class={container}>
        <p class={eyebrow}>{localize(trainingImpact.eyebrow, lang)}</p>
        <h2 id="argumento-title" class={`${heading} max-w-3xl`}>{localize(trainingImpact.title, lang)}</h2>
        <p class={lead}>{localize(trainingImpact.intro, lang)}</p>

        <ImpactTable lang={lang} />
      </div>
    </section>

    <!-- ══════════ PUNTO DE PARTIDA ══════════ -->
    <section
      id="punto-de-partida"
      aria-labelledby="problema-title"
      class="scroll-mt-36 lg:scroll-mt-24 border-t border-slate-200 bg-slate-50 py-14 lg:py-20"
    >
      <div class={container}>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-5">
            <p class={eyebrow}>{localize(trainingProblem.eyebrow, lang)}</p>
            <h2 id="problema-title" class={heading}>{localize(trainingProblem.title, lang)}</h2>
            <p class={lead}>{localize(trainingProblem.intro, lang)}</p>
          </div>

          <ul class="divide-y divide-slate-200 border-t border-slate-200 lg:col-span-7 lg:border-t-0">
            {
              trainingProblem.items.map((item) => (
                <li class="py-4 first:pt-0 lg:first:pt-0">
                  <h3 class="text-[15px] font-semibold tracking-tight text-slate-900">
                    {localize(item.title, lang)}
                  </h3>
                  <p class="mt-1 text-sm leading-relaxed text-slate-600">{localize(item.text, lang)}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ══════════ MODALIDADES Y PRECIO ══════════ -->
    <section
      id="modalidades"
      aria-labelledby="modalidades-title"
      class="scroll-mt-36 lg:scroll-mt-24 border-t border-slate-200 bg-white py-14 lg:py-20"
    >
      <div class={container}>
        <p class={eyebrow}>{lang === 'es' ? 'Modalidades y precios' : 'Formats and prices'}</p>
        <h2 id="modalidades-title" class={`${heading} max-w-3xl`}>
          {
            lang === 'es'
              ? 'Dos formatos, y el pack que encadena los dos'
              : 'Two formats, and the package that chains them together'
          }
        </h2>
        <p class={lead}>
          {
            lang === 'es'
              ? 'Uno para decidir dónde aplicar la IA en la empresa. Otro para que el equipo la use bien en su trabajo diario. Se pueden contratar por separado, pero encadenados rinden más.'
              : 'One to decide where AI fits in the company. Another so the team uses it properly in their daily work. They can be booked separately, but they work better one after the other.'
          }
        </p>

        <div class="mt-10 grid items-stretch gap-6 lg:grid-cols-3 lg:gap-7">
          {
            trainingPrograms.map((program) => (
              <ProgramCard program={program} lang={lang} tone={program.recommended ? 'dark' : 'light'} />
            ))
          }
        </div>

        <p class="mt-8 max-w-3xl text-sm leading-relaxed text-slate-500">
          {localize(trainingPricing.intro, lang)} {localize(trainingPricing.note, lang)}
        </p>

        <!-- ─────── Otras modalidades: menos frecuentes, menos peso ─────── -->
        <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-7">
            <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400">
              {localize(trainingPricing.otherLabel, lang)}
            </h3>
            <ul class="mt-4 divide-y divide-slate-200 border-y border-slate-200">
              {
                trainingPricing.other.map((item) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3.5">
                    <span class="text-[15px] font-medium text-slate-800">
                      {localize(item.title, lang)}
                      <span class="ml-2 font-mono text-xs font-normal text-slate-500">
                        {localize(item.duration, lang)}
                      </span>
                    </span>
                    <span class="font-mono text-sm text-slate-700">
                      {!item.exact && <span class="text-slate-400">{localize(trainingPricing.from, lang)} </span>}
                      <span class="font-semibold text-slate-900">{money(item.priceFrom)} €</span>
                      <span class="text-xs text-slate-400"> {localize(trainingPricing.vat, lang)}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="lg:col-span-5">
            <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400">
              {localize(trainingPricing.conditionsLabel, lang)}
            </h3>
            <ul class="mt-4 space-y-2.5">
              {
                trainingPricing.conditions.map((condition) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-slate-600">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-slate-300" aria-hidden="true" />
                    {localize(condition, lang)}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        {showPhoto(trainingImages.teaching) && (
        <figure class="mt-12">
          <img
            src={trainingImages.teaching.src}
            alt={localize(trainingImages.teaching.alt, lang)}
            width={trainingImages.teaching.width}
            height={trainingImages.teaching.height}
            loading="lazy"
            class="w-full rounded-xl object-cover ring-1 ring-slate-200"
          />
        </figure>
        )}
      </div>
    </section>

    <!-- ══════════ APLICACIONES ══════════ -->
    <section
      id="aplicaciones"
      aria-labelledby="aplicaciones-title"
      class="scroll-mt-36 lg:scroll-mt-24 border-t border-slate-200 bg-slate-50 py-14 lg:py-20"
    >
      <div class={container}>
        <p class={eyebrow}>{localize(trainingUseCases.eyebrow, lang)}</p>
        <h2 id="aplicaciones-title" class={`${heading} max-w-3xl`}>
          {localize(trainingUseCases.title, lang)}
        </h2>
        <p class={lead}>{localize(trainingUseCases.intro, lang)}</p>

        <UseCaseGrid items={trainingUseCases.items} lang={lang} />
      </div>
    </section>

    <!-- ══════════ EL DÍA DE LA SESIÓN ══════════ -->
    <section
      id="sesion"
      aria-labelledby="sesion-title"
      class="scroll-mt-36 lg:scroll-mt-24 border-t border-slate-200 bg-white py-14 lg:py-20"
    >
      <div class={container}>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-4">
            <p class={eyebrow}>{localize(trainingSessionDay.eyebrow, lang)}</p>
            <h2 id="sesion-title" class={heading}>{localize(trainingSessionDay.title, lang)}</h2>
            <p class={lead}>{localize(trainingSessionDay.intro, lang)}</p>
          </div>

          <ul class="grid gap-5 sm:grid-cols-2 lg:col-span-8">
            {
              trainingSessionDay.items.map((item) => (
                <li class="rounded-xl border border-slate-200 p-5">
                  <h3 class="text-[15px] font-semibold tracking-tight text-slate-900">
                    {localize(item.title, lang)}
                  </h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{localize(item.text, lang)}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO FUNCIONA ══════════ -->
    <section
      id="proceso"
      aria-labelledby="proceso-title"
      class="scroll-mt-36 lg:scroll-mt-24 border-t border-slate-200 bg-slate-50 py-14 lg:py-20"
    >
      <div class={container}>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-4">
            <p class={eyebrow}>{localize(trainingProcess.eyebrow, lang)}</p>
            <h2 id="proceso-title" class={heading}>{localize(trainingProcess.title, lang)}</h2>
            <p class={lead}>{localize(trainingProcess.intro, lang)}</p>
          </div>

          <!-- Los pasos van numerados porque el orden es real: cada uno depende del anterior. -->
          <ol class="lg:col-span-8">
            {
              trainingProcess.steps.map((step, index) => (
                <li class="relative flex gap-5 pb-7 last:pb-0">
                  <div class="flex flex-col items-center">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-slate-300 bg-white font-mono text-xs font-semibold text-slate-700">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    {index < trainingProcess.steps.length - 1 && (
                      <span class="mt-1 w-px flex-1 bg-slate-300" aria-hidden="true" />
                    )}
                  </div>
                  <div class="pt-1">
                    <h3 class="text-[15px] font-semibold tracking-tight text-slate-900">
                      {localize(step.title, lang)}
                    </h3>
                    <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-slate-600">
                      {localize(step.text, lang)}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- ══════════ PARA QUIÉN NO ES ══════════ -->
    <section
      id="no-es"
      aria-labelledby="no-es-title"
      class="scroll-mt-36 lg:scroll-mt-24 border-t border-slate-200 bg-white py-14 lg:py-20"
    >
      <div class={container}>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-5">
            <p class={eyebrow}>{localize(trainingNotFor.eyebrow, lang)}</p>
            <h2 id="no-es-title" class={heading}>{localize(trainingNotFor.title, lang)}</h2>
            <p class={lead}>{localize(trainingNotFor.intro, lang)}</p>
          </div>

          <ul class="space-y-3 lg:col-span-7">
            {
              trainingNotFor.items.map((item) => (
                <li class="flex gap-3 text-[15px] leading-relaxed text-slate-600">
                  <svg
                    class="mt-1 h-4 w-4 shrink-0 text-slate-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                  {localize(item, lang)}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ══════════ PREGUNTAS FRECUENTES ══════════ -->
    <section
      id="preguntas"
      aria-labelledby="preguntas-title"
      class="scroll-mt-36 lg:scroll-mt-24 border-t border-slate-200 bg-slate-50 py-14 lg:py-20"
    >
      <div class={container}>
        <p class={eyebrow}>{localize(trainingFaq.eyebrow, lang)}</p>
        <h2 id="preguntas-title" class={heading}>{localize(trainingFaq.title, lang)}</h2>

        <FaqList lang={lang} />
      </div>
    </section>

    <!-- ══════════ QUIÉN LA IMPARTE ══════════ -->
    <section
      id="quien"
      aria-labelledby="quien-title"
      class="scroll-mt-36 lg:scroll-mt-24 border-t border-slate-200 bg-white py-14 lg:py-20"
    >
      <div class={container}>
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-14">
          {
            showPhoto(trainingImages.working) && (
              <div class="lg:col-span-5">
                <img
                  src={trainingImages.working.src}
                  alt={localize(trainingImages.working.alt, lang)}
                  width={trainingImages.working.width}
                  height={trainingImages.working.height}
                  loading="lazy"
                  class="w-full rounded-xl object-cover ring-1 ring-slate-200"
                />
              </div>
            )
          }

          <div class="lg:col-span-7">
            <p class={eyebrow}>{localize(trainingAbout.eyebrow, lang)}</p>
            <h2 id="quien-title" class={`${heading} max-w-2xl`}>{localize(trainingAbout.title, lang)}</h2>

            <p class="mt-4 font-mono text-xs text-slate-500">{personal.name} · {personal.title}</p>

            <div class="mt-5 space-y-4">
              {
                trainingAbout.paragraphs.map((paragraph) => (
                  <p class="max-w-2xl text-[15px] leading-relaxed text-slate-600">
                    {localize(paragraph, lang)}
                  </p>
                ))
              }
            </div>

            <a
              href={`/${lang}`}
              class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-blue-700 transition-colors hover:text-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
            >
              {localize(trainingAbout.cta, lang)}
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ CIERRE Y SOLICITUD ══════════ -->
    <section id="solicitar" aria-labelledby="solicitar-title" class="scroll-mt-36 lg:scroll-mt-24 bg-slate-900 py-16 lg:py-24">
      <div class={container}>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-6">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-blue-400">
              {localize(trainingClosing.eyebrow, lang)}
            </p>
            <h2
              id="solicitar-title"
              class="mt-4 max-w-xl text-2xl font-bold tracking-tight text-white sm:text-3xl lg:text-4xl"
            >
              {localize(trainingClosing.title, lang)}
            </h2>
            <p class="mt-5 max-w-lg text-base leading-relaxed text-slate-300">
              {localize(trainingClosing.text, lang)}
            </p>

            <ContactButtons lang={lang} showForm={false} class="mt-8" />
          </div>

          <div class="lg:col-span-6">
            <TrainingForm lang={lang} />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
