---
/**
 * Tabla de antes y después.
 *
 * Es el bloque que el interlocutor repite cuando defiende la propuesta dentro
 * de su empresa, así que se lee como una tabla de datos y no como un reclamo:
 * tareas concretas, tiempos concretos, y la aritmética a la vista para que
 * cada cual ponga sus números.
 */
import { localize, trainingImpact, type TrainingLang } from '../../data/training';

interface Props {
  lang: TrainingLang;
}

const { lang } = Astro.props;
---

<div class="mt-10 overflow-hidden rounded-xl border border-slate-200">
  <table class="w-full border-collapse text-left">
    <caption class="sr-only">
      {localize(trainingImpact.title, lang)}
    </caption>
    <thead>
      <tr class="bg-slate-50">
        <th scope="col" class="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 sm:px-6">
          {lang === 'es' ? 'Tarea' : 'Task'}
        </th>
        <th
          scope="col"
          class="w-20 px-3 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 sm:w-28 sm:px-4"
        >
          {localize(trainingImpact.beforeLabel, lang)}
        </th>
        <th
          scope="col"
          class="w-20 px-3 py-3 text-right text-xs font-semibold uppercase tracking-wide text-blue-700 sm:w-28 sm:px-6"
        >
          {localize(trainingImpact.afterLabel, lang)}
        </th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200">
      {
        trainingImpact.tasks.map((task) => (
          <tr class="bg-white">
            <th
              scope="row"
              class="px-5 py-4 text-[15px] font-normal leading-snug text-slate-700 sm:px-6"
            >
              {localize(task.task, lang)}
            </th>
            <td class="px-3 py-4 text-right font-mono text-sm text-slate-400 line-through sm:px-4">
              {localize(task.before, lang)}
            </td>
            <td class="px-3 py-4 text-right font-mono text-base font-semibold text-blue-700 sm:px-6">
              {localize(task.after, lang)}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<div class="mt-8 border-l-2 border-blue-600 pl-5">
  <p class="text-[15px] font-semibold tracking-tight text-slate-900">
    {localize(trainingImpact.math.title, lang)}
  </p>
  <p class="mt-2 max-w-2xl text-[15px] leading-relaxed text-slate-600">
    {localize(trainingImpact.math.text, lang)}
  </p>
</div>
